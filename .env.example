# Copy to .env and fill in real values. .env is gitignored.
# Every key the project needs lives here — nothing is hardcoded.

# DeepSeek (content generation)
DEEPSEEK_API_KEY=

# Composio (platform publish + read-back, via the MCP endpoint)
COMPOSIO_API_KEY=
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp

# Publish behaviour: dry_run (default, no real posts) | live (real posts)
PUBLISH_MODE=dry_run

# Required for live telegram publish: chat id the bot delivers to
# (numeric id, @channelusername, or -100... supergroup id)
TELEGRAM_CHAT_ID=

# Your own facebook page id for live facebook publish (absent -> skip)
FACEBOOK_PAGE_ID=

# Optional: your own image generation gateway. Absent -> marked stub.
# Contract: POST {prompt, n} -> {ok: true, job_id: "..."}
#IMAGE_GATEWAY_URL=http://localhost:3000/api/studio/image

# Trip-planner source (grounding facts for generation)
REFERENCE_SITE_URL=https://1000usdinchina.com

# Langfuse tracing (optional; unset -> tracing fully off)
# Self-hosted: docker compose stack; cloud: https://cloud.langfuse.com
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...
#LANGFUSE_HOST=http://localhost:13000

# LLM quality judge (eval + advisory verdict in the approve payload)
#AGENT_JUDGE=1

# Guardrails
#TASK_BUDGET_USD=0.10
#APH_RECURSION_LIMIT=24
#PRICE_IN_PER_M=0.27
#PRICE_OUT_PER_M=1.10
