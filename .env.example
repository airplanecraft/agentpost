# Copy to .env and fill in real values. .env is gitignored.
# Every key the project needs lives here — nothing is hardcoded.

# ── generation LLM (required) ─────────────────────────────────
DEEPSEEK_API_KEY=
# Model swap experiments: deepseek-chat (default) | deepseek-reasoner
#DEEPSEEK_MODEL=deepseek-chat

# ── platform publish via Composio MCP ────────────────────────
COMPOSIO_API_KEY=
#COMPOSIO_MCP_URL=https://connect.composio.dev/mcp

# dry_run (default — nothing real is posted) | live
PUBLISH_MODE=dry_run

# Live targets (your own channel / page). Absent → platform skips cleanly.
#TELEGRAM_CHAT_ID=-100xxxxxxxxxx
#FACEBOOK_PAGE_ID=

# ── A2A grounding agent ──────────────────────────────────────
#REFERENCE_SITE_URL=https://1000usdinchina.com

# ── tracing (self-hosted Langfuse; unset = fully off) ────────
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_HOST=http://localhost:13000

# ── vector memory (Chroma + Qwen embeddings) ─────────────────
# Either DashScope (cloud, Qwen family) or local ollama:
#DASHSCOPE_API_KEY=
#QWEN_EMBED_URL=http://localhost:11434
#QWEN_EMBED_MODEL=qwen3-embedding
#APH_VECTOR_DIR=aph_vectors

# ── evaluation ───────────────────────────────────────────────
# 1 = LLM judge in product eval + advisory verdict at the approve gate
#AGENT_JUDGE=1

# ── guardrails ───────────────────────────────────────────────
# Per-task spend cap (usd) before routing to the human gate
#TASK_BUDGET_USD=0.10
# Explicit superstep cap (worst legal path ~15; 24 gives headroom)
#APH_RECURSION_LIMIT=24
# Optional price overrides (usd per 1M tokens) for cost accounting
#PRICE_IN_PER_M=0.27
#PRICE_OUT_PER_M=1.10

# ── optional own image gateway ───────────────────────────────
# Contract: POST {prompt, n} → {ok: true, job_id: "..."}
#IMAGE_GATEWAY_URL=http://localhost:3000/api/studio/image

# ── storage overrides ────────────────────────────────────────
#APH_DB_PATH=aph.db
#APH_STORE_PATH=aph_store.db
