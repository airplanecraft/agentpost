<mxfile host="app.diagrams.net">
  <diagram name="AgentPostHub Workflow" id="aph1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== Main pipeline (top to bottom) ===== -->
        <mxCell id="sched" value="Scheduler (tick)&#10;picks due tasks: publish / sync / discover&#10;— no manual selection —" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="discover" value="Discover Agent&#10;scans rising posts&#10;karma-threshold filters&#10;auto-selects targets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="150" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="gen" value="Gen Agent&#10;route brief → draft content&#10;(model-led, prompt-versioned)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="270" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="approve" value="⏸ APPROVAL QUEUE&#10;HUMAN GATE&#10;propose / execute separation&#10;only approved items proceed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="360" y="380" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="publish" value="Publish Agent&#10;MCP tool calls (Composio)&#10;YT · FB · TG · Reddit · Notion&#10;structured input validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="500" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="verify" value="Post-Exec Verification&#10;read-back platform state&#10;(phantom-publish guard)&#10;confirmed ≠ assumed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="620" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="history" value="publish_history&#10;append-only · action-level audit&#10;every action traceable to its authorizing&#10;human decision or explicit rule" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="740" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- ===== Side: rules engine + eval ===== -->
        <mxCell id="rules" value="Strategy Rules Engine&#10;trust tiers · link-privilege rules&#10;pacing 3–3.5h randomized · rate ceilings&#10;(policy enforcement is CODE, not prompts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="150" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="eval" value="Eval Harness&#10;golden checks + deterministic assertions&#10;gates every model/prompt change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="300" width="260" height="80" as="geometry"/>
        </mxCell>

        <!-- ===== Side: failure handling ===== -->
        <mxCell id="failsm" value="Failure State Machine&#10;cooldown + retry · liveness probes&#10;1h / 6h / 24h / 72h auto-recovery&#10;checkpoint resume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="escalate" value="⏸ ESCALATION&#10;HUMAN decision&#10;outcome recorded as policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- ===== Observability band ===== -->
        <mxCell id="obs" value="Observability — per-call traces (task → tool call → verification → artifact) · latency · cost metering · daily rollups · budget ceilings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="280" height="90" as="geometry"/>
        </mxCell>

        <!-- ===== Edges: main flow ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="sched" target="discover"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="targets + brief" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="discover" target="gen"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="draft" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="gen" target="approve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="HUMAN approval" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="approve" target="publish"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="tool executed" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="publish" target="verify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="confirmed" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="verify" target="history"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Edges: rules & eval -->
        <mxCell id="e7" value="filters / thresholds" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="rules" target="discover"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="pacing / link rules" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="rules" target="publish"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="gates changes" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="eval" target="gen"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Edges: failure loop -->
        <mxCell id="e10" value="exception / silent failure" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;" edge="1" parent="1" source="publish" target="failsm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="state mismatch" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;" edge="1" parent="1" source="verify" target="failsm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="cooldown + retry" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;" edge="1" parent="1" source="failsm" target="publish"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="sustained failure" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="failsm" target="escalate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="policy update" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="escalate" target="rules"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="120"/><mxPoint x="660" y="120"/></Array></mxGeometry></mxCell>

        <!-- Observability dashed edges -->
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="publish" target="obs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="verify" target="obs"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
